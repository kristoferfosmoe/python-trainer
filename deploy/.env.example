# Copy to deploy/.env and fill in. Never commit deploy/.env.

# The site's domain name. Point its DNS A record at the EC2 Elastic IP first.
DOMAIN=trainer.example.org

# Make a long random secret:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=trainer.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://trainer.example.org

POSTGRES_DB=trainer
POSTGRES_USER=trainer
# Another long random value:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-me

# Web server processes (about 2 per CPU core).
GUNICORN_WORKERS=3

# Reload lessons from content/ on every start (true/false).
IMPORT_CONTENT_ON_START=true

# Nightly database backups (deploy/backup.sh).
BACKUP_S3_URI=s3://your-bucket-name/python-trainer
